<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Allows HTTP for custom/on-prem API URLs (matches usesCleartextTraffic). -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
